generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITE_ONLY
}

enum InvestmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum LedgerEntryType {
  DEPOSIT_CREDIT
  INVESTMENT_DEBIT
  VERIFIED_EARNING_CREDIT
  WITHDRAWAL_RESERVE
  WITHDRAWAL_HOLD
  WITHDRAWAL_RELEASE
  WITHDRAWAL_UNHOLD
  WITHDRAWAL_PAYOUT
  WITHDRAWAL_FEE
  REFERRAL_COMMISSION_CREDIT
}

enum LedgerBalanceBucket {
  AVAILABLE
  RESERVED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

enum WithdrawalDecision {
  PROCESSING
  COMPLETED
  REJECTED
}

enum DepositStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
}

enum DepositFilePurpose {
  RECEIPT
  QR
}

model User {
  id           String      @id @default(cuid())
  mobileNumber String      @unique
  passwordHash String
  referralCode String      @unique
  referredBy   String?
  role         UserRole    @default(USER)
  status       UserStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  referrer  User?     @relation("UserReferrals", fields: [referredBy], references: [id], onDelete: Restrict)
  referrals User[]    @relation("UserReferrals")
  sessions  Session[]
  wallet    Wallet?
  investments Investment[]
  ledgerEntries LedgerEntry[]
  depositImages DepositImage[]
  depositRequests DepositRequest[]
  reviewedDeposits DepositRequest[] @relation("DepositReviewer")
  depositDecisionAudits DepositDecisionAudit[]
  withdrawals WithdrawalRequest[] @relation("WithdrawalOwner")
  processingWithdrawals WithdrawalRequest[] @relation("WithdrawalProcessor")
  reviewedWithdrawals WithdrawalRequest[] @relation("WithdrawalReviewer")
  withdrawalAudits WithdrawalAudit[]
  receivedWithdrawalHandoffs WithdrawalHandoff[] @relation("HandoffReceiver")
  previousWithdrawalHandoffs WithdrawalHandoff[] @relation("HandoffPrevious")
  withdrawalNotifications WithdrawalNotification[]
  referralCommissions ReferralCommission[] @relation("CommissionBeneficiary")
  generatedCommissions ReferralCommission[] @relation("CommissionSourceUser")
  commissionAudits CommissionAudit[]
  capitalFunding CompanyCapital[]
  rateChanges ReferralRateVersion[]
  referralNotifications ReferralNotification[]
  archivedDeposits ArchivedManualDeposit[] @relation("MemberDeposits")
  archivedDepositDecisions ArchivedManualDeposit[] @relation("AdminDepositDecisions")
  depositFiles DepositFile[]
  paymentSettingsUpdates PaymentSettings[]

  @@index([referredBy])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Wallet {
  id               String   @id @default(cuid())
  userId           String   @unique
  availableBalance Decimal  @default(0) @db.Decimal(16, 2)
  reservedBalance Decimal @default(0) @db.Decimal(16, 2)
  activeWithdrawalId String? @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InvestmentPlan {
  id              String   @id
  name            String
  principalAmount Decimal  @db.Decimal(16, 2)
  dailyAmount     Decimal  @db.Decimal(16, 2)
  duration        Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  investments Investment[]
}

model Investment {
  id                String           @id @default(cuid())
  userId            String
  planId            String
  principalAmount   Decimal          @db.Decimal(16, 2)
  dailyAmount       Decimal          @db.Decimal(16, 2)
  duration          Int
  startDate         DateTime
  endDate           DateTime
  accumulatedAmount Decimal          @default(0) @db.Decimal(16, 2)
  status            InvestmentStatus @default(ACTIVE)
  idempotencyKey    String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan         InvestmentPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  ledgerEntries LedgerEntry[]
  referralCommissions ReferralCommission[]

  @@unique([userId, idempotencyKey])
  @@index([userId, status])
  @@index([status, endDate])
}

model LedgerEntry {
  id                String          @id @default(cuid())
  userId            String
  investmentId      String?
  reference         String          @unique
  type              LedgerEntryType
  amount            Decimal         @db.Decimal(16, 2)
  balanceAfter      Decimal         @db.Decimal(16, 2)
  createdAt         DateTime        @default(now())
  depositRequestId  String?         @unique
  depositId String? @unique
  withdrawalId String?
  referralCommissionId String? @unique
  balanceBucket LedgerBalanceBucket @default(AVAILABLE)

  user       User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  investment Investment?  @relation(fields: [investmentId], references: [id], onDelete: Restrict)
  depositRequest DepositRequest? @relation(fields: [depositRequestId], references: [id], onDelete: Restrict)
  withdrawal WithdrawalRequest? @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)
  referralCommission ReferralCommission? @relation("CommissionCredit", fields: [referralCommissionId], references: [id], onDelete: Restrict)
  sourceCommissions ReferralCommission[] @relation("CommissionSource")
  archivedDeposit ArchivedManualDeposit? @relation(fields: [depositId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([investmentId, type])
  @@index([withdrawalId, type])
}

model WithdrawalRequest {
  id String @id @default(cuid())
  userId String
  requestedAmount Decimal @db.Decimal(16, 2)
  feeAmount Decimal @db.Decimal(16, 2)
  netAmount Decimal @db.Decimal(16, 2)
  feeBasisPoints Int @default(500)
  accountName String
  accountNumber String
  idempotencyKey String
  status WithdrawalStatus @default(PENDING)
  processingById String?
  processedAt DateTime?
  reviewedById String?
  reviewedAt DateTime?
  completedAt DateTime?
  payoutReference String? @unique
  verificationNote String?
  rejectionReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation("WithdrawalOwner", fields: [userId], references: [id], onDelete: Restrict)
  processor User? @relation("WithdrawalProcessor", fields: [processingById], references: [id], onDelete: Restrict)
  reviewer User? @relation("WithdrawalReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  ledgerEntries LedgerEntry[]
  audits WithdrawalAudit[]
  handoffs WithdrawalHandoff[]
  notifications WithdrawalNotification[]
  companyFundEntries CompanyFundEntry[]
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model WithdrawalHandoff {
  id String @id @default(cuid())
  withdrawalId String
  fromAdminId String
  toAdminId String
  payoutStatus String
  payoutReference String?
  note String
  createdAt DateTime @default(now())
  withdrawal WithdrawalRequest @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)
  previousAdmin User @relation("HandoffPrevious", fields: [fromAdminId], references: [id], onDelete: Restrict)
  receivingAdmin User @relation("HandoffReceiver", fields: [toAdminId], references: [id], onDelete: Restrict)
  @@index([withdrawalId, createdAt])
}

model WithdrawalAudit {
  id String @id @default(cuid())
  withdrawalId String
  adminId String
  decision WithdrawalDecision
  payoutReference String?
  note String
  createdAt DateTime @default(now())
  withdrawal WithdrawalRequest @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)
  admin User @relation(fields: [adminId], references: [id], onDelete: Restrict)
  @@unique([withdrawalId, decision])
}

model WithdrawalNotification {
  id String @id @default(cuid())
  userId String
  withdrawalId String
  status WithdrawalStatus
  message String
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  withdrawal WithdrawalRequest @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)
  @@unique([withdrawalId, status])
  @@index([userId, readAt])
}

enum CommissionStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum CompanyFundEntryType {
  VERIFIED_CAPITAL
  VERIFIED_FEE
  COMMISSION_RESERVE
  COMMISSION_HOLD
  COMMISSION_RELEASE
  COMMISSION_UNHOLD
  COMMISSION_TRANSFER
}

model ReferralRateVersion {
  id String @id @default(cuid())
  version Int @unique
  tier1BasisPoints Int
  tier2BasisPoints Int
  tier3BasisPoints Int
  effectiveFrom DateTime
  sourceType String @default("INVESTMENT")
  changedById String?
  changeReason String
  createdAt DateTime @default(now())
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: Restrict)
  commissions ReferralCommission[]
}

model CommissionFund {
  id String @id
  availableBalance Decimal @default(0) @db.Decimal(16, 2)
  reservedBalance Decimal @default(0) @db.Decimal(16, 2)
  updatedAt DateTime @updatedAt
}

model ReferralCommission {
  id String @id @default(cuid())
  beneficiaryId String
  sourceUserId String
  investmentId String?
  depositId String?
  sourceLedgerId String
  sourceTransactionReference String
  rateVersionId String
  tier Int
  rateBasisPoints Int
  basisAmount Decimal @db.Decimal(16, 2)
  amount Decimal @db.Decimal(16, 2)
  status CommissionStatus @default(PENDING)
  approvedAt DateTime?
  paidAt DateTime?
  rejectedAt DateTime?
  rejectionReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  beneficiary User @relation("CommissionBeneficiary", fields: [beneficiaryId], references: [id], onDelete: Restrict)
  sourceUser User @relation("CommissionSourceUser", fields: [sourceUserId], references: [id], onDelete: Restrict)
  investment Investment? @relation(fields: [investmentId], references: [id], onDelete: Restrict)
  deposit DepositRequest? @relation(fields: [depositId], references: [id], onDelete: Restrict)
  sourceLedger LedgerEntry @relation("CommissionSource", fields: [sourceLedgerId], references: [id], onDelete: Restrict)
  rateVersion ReferralRateVersion @relation(fields: [rateVersionId], references: [id], onDelete: Restrict)
  ledgerEntry LedgerEntry? @relation("CommissionCredit")
  audits CommissionAudit[]
  fundEntries CompanyFundEntry[]
  notifications ReferralNotification[]
  @@unique([investmentId, tier])
  @@unique([investmentId, beneficiaryId])
  @@unique([depositId, tier])
  @@unique([depositId, beneficiaryId])
  @@index([beneficiaryId, status, createdAt])
  @@index([status, createdAt])
}

model CommissionAudit {
  id String @id @default(cuid())
  commissionId String
  adminId String
  decision CommissionStatus
  note String
  createdAt DateTime @default(now())
  commission ReferralCommission @relation(fields: [commissionId], references: [id], onDelete: Restrict)
  admin User @relation(fields: [adminId], references: [id], onDelete: Restrict)
  @@unique([commissionId, decision])
}

model CompanyCapital {
  id String @id @default(cuid())
  amount Decimal @db.Decimal(16, 2)
  transactionReference String @unique
  receiptImageId String @unique
  receiptDigest String @unique
  verifiedById String
  verificationNote String
  idempotencyKey String
  createdAt DateTime @default(now())
  receipt DepositImage @relation(fields: [receiptImageId], references: [id], onDelete: Restrict)
  verifier User @relation(fields: [verifiedById], references: [id], onDelete: Restrict)
  fundEntries CompanyFundEntry[]
  @@unique([verifiedById, idempotencyKey])
}

model CompanyFundEntry {
  id String @id @default(cuid())
  reference String @unique
  type CompanyFundEntryType
  balanceBucket LedgerBalanceBucket
  amount Decimal @db.Decimal(16, 2)
  balanceAfter Decimal @db.Decimal(16, 2)
  commissionId String?
  capitalId String?
  withdrawalId String?
  createdAt DateTime @default(now())
  commission ReferralCommission? @relation(fields: [commissionId], references: [id], onDelete: Restrict)
  capital CompanyCapital? @relation(fields: [capitalId], references: [id], onDelete: Restrict)
  withdrawal WithdrawalRequest? @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)
  @@index([type, createdAt])
}

model IncomingPaymentClaim {
  reference String @id
  receiptDigest String @unique
  sourceId String @unique
  kind String
  createdAt DateTime @default(now())
}

model ReferralNotification {
  id String @id @default(cuid())
  userId String
  eventKey String @unique
  type String
  message String
  commissionId String?
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  commission ReferralCommission? @relation(fields: [commissionId], references: [id], onDelete: Restrict)
  @@index([userId, readAt, createdAt])
}

enum DepositImagePurpose {
  QR
  RECEIPT
  CAPITAL_RECEIPT
}

enum DepositRequestStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
}

enum DepositDecisionType {
  APPROVED
  REJECTED
}

model DepositImage {
  id          String @id @default(cuid())
  userId      String
  purpose     DepositImagePurpose
  objectPath  String @unique
  contentType String
  size        Int
  digest      String
  createdAt   DateTime @default(now())
  user        User @relation(fields: [userId], references: [id], onDelete: Restrict)
  request     DepositRequest?
  settings    DepositPaymentSettings[]
  capitalFunding CompanyCapital?

  @@index([userId, createdAt])
}

model DepositPaymentSettings {
  id                 String @id @default("gcash")
  qrImageId          String?
  accountName        String @default("")
  accountNumber      String @default("")
  instructions       String @default("")
  minimumAmount      Decimal @default(350) @db.Decimal(16, 2)
  accountDetailsConfirmed Boolean @default(false)
  submissionsEnabled Boolean @default(false)
  version            Int @default(0)
  updatedAt          DateTime @updatedAt
  qrImage            DepositImage? @relation(fields: [qrImageId], references: [id], onDelete: Restrict)
}

model DepositRequest {
  id                 String @id @default(cuid())
  userId             String
  amount             Decimal @db.Decimal(16, 2)
  transactionReference String @unique
  receiptImageId     String @unique
  receiptDigest      String @unique
  idempotencyKey     String
  status             DepositRequestStatus @default(PENDING_VERIFICATION)
  accountName        String
  accountNumber      String
  settingsVersion    Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  reviewedById       String?
  reviewedAt         DateTime?
  approvedAt         DateTime?
  verifiedAmount     Decimal? @db.Decimal(16, 2)
  rejectionReason    String?
  user               User @relation(fields: [userId], references: [id], onDelete: Restrict)
  receiptImage       DepositImage @relation(fields: [receiptImageId], references: [id], onDelete: Restrict)
  reviewedBy         User? @relation("DepositReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  decisionAudit      DepositDecisionAudit?
  ledgerEntry        LedgerEntry?
  referralCommissions ReferralCommission[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model DepositDecisionAudit {
  id             String @id @default(cuid())
  depositId      String @unique
  adminId        String
  decision       DepositDecisionType
  verifiedAmount Decimal? @db.Decimal(16, 2)
  verificationNote String?
  amountDifferenceConfirmed Boolean @default(false)
  rejectionReason String?
  createdAt      DateTime @default(now())
  deposit        DepositRequest @relation(fields: [depositId], references: [id], onDelete: Restrict)
  admin          User @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt])
}

// Preserved evidence and accounting from the first, disabled implementation.
// These are audit archives, not a second payment submission system.
model ArchivedManualDeposit {
  id String @id @default(cuid())
  userId String
  amount Decimal @db.Decimal(16, 2)
  transactionReference String @unique
  receiptFileId String @unique
  status DepositStatus @default(PENDING_VERIFICATION)
  verifiedAmount Decimal? @db.Decimal(16, 2)
  reason String @default("")
  reviewedBy String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  paymentDetails Json
  user User @relation("MemberDeposits", fields: [userId], references: [id], onDelete: Restrict)
  admin User? @relation("AdminDepositDecisions", fields: [reviewedBy], references: [id], onDelete: Restrict)
  receipt DepositFile @relation(fields: [receiptFileId], references: [id], onDelete: Restrict)
  ledgerEntry LedgerEntry?
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model DepositFile {
  id String @id @default(cuid())
  ownerId String
  purpose DepositFilePurpose
  contentType String
  size Int
  stagingPath String @unique
  objectPath String? @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  deposit ArchivedManualDeposit?
  settings PaymentSettings[]
  @@index([ownerId, createdAt])
}

model PaymentSettings {
  id String @id @default("gcash")
  enabled Boolean @default(false)
  accountName String @default("")
  accountNumber String @default("")
  instructions String @default("")
  qrFileId String?
  updatedBy String?
  updatedAt DateTime @updatedAt
  qrFile DepositFile? @relation(fields: [qrFileId], references: [id], onDelete: Restrict)
  admin User? @relation(fields: [updatedBy], references: [id], onDelete: Restrict)
}
