generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITE_ONLY
}

enum InvestmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum LedgerEntryType {
  DEPOSIT_CREDIT
  INVESTMENT_DEBIT
  VERIFIED_EARNING_CREDIT
}

model User {
  id           String      @id @default(cuid())
  mobileNumber String      @unique
  passwordHash String
  referralCode String      @unique
  referredBy   String?
  role         UserRole    @default(USER)
  status       UserStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  referrer  User?     @relation("UserReferrals", fields: [referredBy], references: [id], onDelete: Restrict)
  referrals User[]    @relation("UserReferrals")
  sessions  Session[]
  wallet    Wallet?
  investments Investment[]
  ledgerEntries LedgerEntry[]
  depositImages DepositImage[]
  depositRequests DepositRequest[]
  reviewedDeposits DepositRequest[] @relation("DepositReviewer")
  depositDecisionAudits DepositDecisionAudit[]

  @@index([referredBy])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Wallet {
  id               String   @id @default(cuid())
  userId           String   @unique
  availableBalance Decimal  @default(0) @db.Decimal(16, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InvestmentPlan {
  id              String   @id
  name            String
  principalAmount Decimal  @db.Decimal(16, 2)
  dailyAmount     Decimal  @db.Decimal(16, 2)
  duration        Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  investments Investment[]
}

model Investment {
  id                String           @id @default(cuid())
  userId            String
  planId            String
  principalAmount   Decimal          @db.Decimal(16, 2)
  dailyAmount       Decimal          @db.Decimal(16, 2)
  duration          Int
  startDate         DateTime
  endDate           DateTime
  accumulatedAmount Decimal          @default(0) @db.Decimal(16, 2)
  status            InvestmentStatus @default(ACTIVE)
  idempotencyKey    String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan         InvestmentPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  ledgerEntries LedgerEntry[]

  @@unique([userId, idempotencyKey])
  @@index([userId, status])
  @@index([status, endDate])
}

model LedgerEntry {
  id                String          @id @default(cuid())
  userId            String
  investmentId      String?
  reference         String          @unique
  type              LedgerEntryType
  amount            Decimal         @db.Decimal(16, 2)
  balanceAfter      Decimal         @db.Decimal(16, 2)
  createdAt         DateTime        @default(now())
  depositRequestId  String?         @unique

  user       User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  investment Investment?  @relation(fields: [investmentId], references: [id], onDelete: Restrict)
  depositRequest DepositRequest? @relation(fields: [depositRequestId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([investmentId, type])
}

enum DepositImagePurpose {
  QR
  RECEIPT
}

enum DepositRequestStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
}

enum DepositDecisionType {
  APPROVED
  REJECTED
}

model DepositImage {
  id          String @id @default(cuid())
  userId      String
  purpose     DepositImagePurpose
  objectPath  String @unique
  contentType String
  size        Int
  digest      String
  createdAt   DateTime @default(now())
  user        User @relation(fields: [userId], references: [id], onDelete: Restrict)
  request     DepositRequest?
  settings    DepositPaymentSettings[]

  @@index([userId, createdAt])
}

model DepositPaymentSettings {
  id                 String @id @default("gcash")
  qrImageId          String?
  accountName        String @default("")
  accountNumber      String @default("")
  instructions       String @default("")
  minimumAmount      Decimal @default(1) @db.Decimal(16, 2)
  submissionsEnabled Boolean @default(false)
  version            Int @default(0)
  updatedAt          DateTime @updatedAt
  qrImage            DepositImage? @relation(fields: [qrImageId], references: [id], onDelete: Restrict)
}

model DepositRequest {
  id                 String @id @default(cuid())
  userId             String
  amount             Decimal @db.Decimal(16, 2)
  transactionReference String @unique
  receiptImageId     String @unique
  receiptDigest      String @unique
  idempotencyKey     String
  status             DepositRequestStatus @default(PENDING_VERIFICATION)
  accountName        String
  accountNumber      String
  settingsVersion    Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  reviewedById       String?
  reviewedAt         DateTime?
  approvedAt         DateTime?
  verifiedAmount     Decimal? @db.Decimal(16, 2)
  rejectionReason    String?
  user               User @relation(fields: [userId], references: [id], onDelete: Restrict)
  receiptImage       DepositImage @relation(fields: [receiptImageId], references: [id], onDelete: Restrict)
  reviewedBy         User? @relation("DepositReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  decisionAudit      DepositDecisionAudit?
  ledgerEntry        LedgerEntry?

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model DepositDecisionAudit {
  id             String @id @default(cuid())
  depositId      String @unique
  adminId        String
  decision       DepositDecisionType
  verifiedAmount Decimal? @db.Decimal(16, 2)
  verificationNote String?
  amountDifferenceConfirmed Boolean @default(false)
  rejectionReason String?
  createdAt      DateTime @default(now())
  deposit        DepositRequest @relation(fields: [depositId], references: [id], onDelete: Restrict)
  admin          User @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt])
}
