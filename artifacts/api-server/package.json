{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:referrals": "esbuild src/lib/referrals.test.ts --bundle --platform=node --format=esm --external:@prisma/client --external:@google-cloud/storage --external:sharp --external:multer --external:express --external:pino --external:pino-http --external:cookie-parser --external:cors --outfile=.cache/referrals.test.mjs && node .cache/referrals.test.mjs",
    "test:investments": "esbuild src/lib/investments.test.ts --bundle --platform=node --format=esm --external:@prisma/client --outfile=.cache/investments.test.mjs && node .cache/investments.test.mjs",
    "test:withdrawals": "esbuild src/lib/withdrawals.test.ts --bundle --platform=node --format=esm --external:@prisma/client --external:@google-cloud/storage --external:sharp --external:multer --external:express --external:pino --external:pino-http --external:cookie-parser --external:cors --outfile=.cache/withdrawals.test.mjs && node .cache/withdrawals.test.mjs",
    "test:deposits": "esbuild src/lib/manual-deposits.test.ts --bundle --platform=node --format=esm --external:@prisma/client --external:@google-cloud/storage --external:sharp --external:multer --external:express --external:pino --external:pino-http --external:cookie-parser --external:cors --outfile=.cache/manual-deposits.test.mjs && node .cache/manual-deposits.test.mjs",
    "prepare:gcash-qr": "esbuild src/scripts/prepare-gcash-qr.ts --bundle --platform=node --format=esm --packages=external --alias:@workspace/db=../../lib/db/src/index.ts --outfile=.cache/prepare-gcash-qr.mjs && node .cache/prepare-gcash-qr.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.3.0",
    "@prisma/client": "6.19.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.1",
    "thread-stream": "3.1.0"
  }
}
